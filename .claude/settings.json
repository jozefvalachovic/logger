{
  "env": {
    "GOWORK": "off"
  },
  "permissions": {
    "allow": [
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(go list *)",
      "Bash(go doc *)",
      "Bash(go fix -diff *)",
      "Bash(go mod verify)",
      "Bash(gofmt -l *)",
      "Bash(golangci-lint run *)",
      "Bash(staticcheck *)",
      "Bash(govulncheck *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(gh release *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; case \"$f\" in *.go) gofmt -w \"$f\";; esac; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
